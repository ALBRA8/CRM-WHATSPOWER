# .env.example — plantilla de entorno de desarrollo
# Copiar a .env y completar. NUNCA subir el .env real (gitignore activo).

# --- Núcleo (VESTRO / apps/web) ---
DATABASE_URL=postgresql://vestro:vestro_dev_only@localhost:5433/vestro
AUTH_SECRET=cambia_esto_por_un_secreto_largo

# --- Adaptador AGENTE-GENERAL (services/agent-gateway) ---
AGENT_DISPATCH_URL=http://localhost:8080
AGENT_API_URL=http://localhost:8080
AGENT_API_KEY=
AGENT_SIGNING_SECRET=
# Interruptor de IA: sin agente en línea → sin_cerebro → bandeja manual

# --- Bot API (agente → núcleo) ---
BOT_API_KEY=

# --- Motor de flujos (services/flows) ---
FLOWS_URL=http://localhost:8081
FLOWS_SECRET=

# --- Motor de campañas (services/campaigns) ---
CAMPAIGNS_URL=http://localhost:8082
CAMPAIGNS_SECRET=

# --- Salvaguarda global de envío real (fail-closed por defecto) ---
ALLOW_REAL_DISPATCH=false
